###############################################################################
# Yelp /businesses/search — PICT model (3 top-usage US cities, tuned for hits)
# Notes:
#   * Keep NULL as an option for each parameter.
#   * Cities picked where Yelp usage & POI density are very high.
###############################################################################

# -------------------------
# Parameter definitions
# -------------------------

# Locations (underscore for spaces)
location: NULL*San Francisco*New York*Los Angeles

# Match lat/lon to the above (same order)
latitude:  NULL*37.7749*40.7128*34.0522
longitude: NULL*-122.4194*-74.0060*-118.2437

# Popular, generic search terms (kept compact)
term: NULL*restaurants*food*cafe

# Reasonable radii (m) that avoid AREA_TOO_LARGE while staying dense
radius: NULL*1500*5000*20000

# Three multi-value category sets (high hit-rate)
categories: NULL*restaurants,coffee,bars*sushi,italian,mexican*chinese,pizza,breakfast_brunch,cafes

# Locale focused on US (most stable for these cities)
locale: NULL*en_US*fr_FR*es_ES

# Common price tiers (avoid 4-only which can thin results)
price: NULL*1*2*3*4

# Keep open_now mostly relaxed; open_at for evening dining
open_now: NULL*false*true
open_at:  NULL*1760037000*1760043600*1760049900

# Attributes that don't over-filter
attributes: NULL*hot_and_new,request_a_quote*waitlist_reservation,gender_neutral_restrooms*open_to_all,reservation,wheelchair_accessible

# Sort modes
sort_by: best_match*rating*review_count*distance

# Mobile platform (official uses hyphen)
device_platform: NULL*android*ios*mobile-generic

# Reservation parameters – small, typical party sizes
reservation_date:  NULL*2025-11-10*2025-12-31*2026-01-15
reservation_time:  NULL*18:30*20:00*21:30
reservation_covers: NULL*2*4*6*8*10
matches_party_size_param: NULL*false*true

# Conservative pagination
limit:  NULL*10*20*50
offset: NULL*0*1*2

###############################################################################
# Constraints
###############################################################################

# (1) Either free-form location OR (lat & lon), but not both
IF [location] = "NULL" THEN ([latitude] <> "NULL" AND [longitude] <> "NULL");
IF [location] <> "NULL" THEN ([latitude] = "NULL" AND [longitude] = "NULL");

# Tie specific lat/lon to location when both given (keep consistent)
IF [latitude] = "37.7749" THEN [longitude] = "-122.4194";
IF [latitude] = "40.7128" THEN [longitude] = "-74.0060";
IF [latitude] = "34.0522" THEN [longitude] = "-118.2437";

# (2) ZeroOrOne(open_now, open_at)
IF [open_now] <> "NULL" THEN [open_at] = "NULL";
IF [open_at] <> "NULL" THEN [open_now] = "NULL";

IF [reservation_date] <> "NULL" OR [reservation_time] <> "NULL" OR [reservation_covers] <> "NULL" OR [matches_party_size_param] = "true" THEN
    ([reservation_date] <> "NULL" AND [reservation_time] <> "NULL" AND [reservation_covers] <> "NULL");
