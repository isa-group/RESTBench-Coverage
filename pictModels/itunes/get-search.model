country: US * JP
media: movie * podcast * music * musicVideo * audiobook * shortFilm * tvShow * software * ebook * all * NULL
entity: movieArtist*movie*podcastAuthor*podcast*podcastEpisode*musicArtist*musicTrack*album*musicVideo*mix*song*audiobookAuthor*audiobook*shortFilmArtist*shortFilm*tvEpisode*tvSeason*software*iPadSoftware*desktopSoftware*ebook*allArtist*allTrack * NULL
attribute: actorTerm*genreIndex*artistTerm*shortFilmTerm*producerTerm*ratingTerm*directorTerm*releaseYearTerm*featureFilmTerm*movieArtistTerm*movieTerm*ratingIndex*descriptionTerm*titleTerm*languageTerm*authorTerm*keywordsTerm*mixTerm*composerTerm*albumTerm*songTerm*softwareDeveloper*tvEpisodeTerm*showTerm*tvSeasonTerm*allArtistTerm*allTrackTerm * NULL
limit: 10 * 20 * 30 * NULL
lang: en_us * ja_jp * NULL
explicit: Yes * No * NULL

# Constraints: entity allowed per media
IF [media] = "movie"      THEN [entity] IN {"movieArtist", "movie"};
IF [media] = "podcast"    THEN [entity] IN {"podcastAuthor", "podcast", "podcastEpisode"};
IF [media] = "music"      THEN [entity] IN {"musicArtist", "musicTrack", "album", "musicVideo", "mix", "song"};
IF [media] = "musicVideo" THEN [entity] IN {"musicArtist", "musicVideo"};
IF [media] = "audiobook"  THEN [entity] IN {"audiobookAuthor", "audiobook"};
IF [media] = "shortFilm"  THEN [entity] IN {"shortFilmArtist", "shortFilm"};
IF [media] = "tvShow"     THEN [entity] IN {"tvEpisode", "tvSeason"};
IF [media] = "software"   THEN [entity] IN {"software", "iPadSoftware", "desktopSoftware"};
IF [media] = "ebook"      THEN [entity] = "ebook" AND [attribute] = "NULL";
IF [media] = "all"        THEN [entity] IN {"movie", "album", "allArtist", "podcast", "musicVideo", "mix", "audiobook", "tvSeason", "allTrack"};

# Constraints: attribute allowed per media
IF [media] = "movie" THEN [attribute] IN {
  "actorTerm", "genreIndex", "artistTerm", "shortFilmTerm", "producerTerm", "ratingTerm",
  "directorTerm", "releaseYearTerm", "featureFilmTerm", "movieArtistTerm", "movieTerm",
  "ratingIndex", "descriptionTerm"
};

IF [media] = "podcast" THEN [attribute] IN {
  "titleTerm", "languageTerm", "authorTerm", "genreIndex", "artistTerm",
  "ratingIndex", "keywordsTerm", "descriptionTerm"
};

IF [media] = "music" THEN [attribute] IN {
  "mixTerm", "genreIndex", "artistTerm", "composerTerm", "albumTerm", "ratingIndex", "songTerm"
};

IF [media] = "musicVideo" THEN [attribute] IN {
  "genreIndex", "artistTerm", "albumTerm", "ratingIndex", "songTerm"
};

IF [media] = "audiobook" THEN [attribute] IN {
  "titleTerm", "authorTerm", "genreIndex", "ratingIndex"
};

IF [media] = "shortFilm" THEN [attribute] IN {
  "genreIndex", "artistTerm", "shortFilmTerm", "ratingIndex", "descriptionTerm"
};

IF [media] = "tvShow" THEN [attribute] IN {
  "genreIndex", "tvEpisodeTerm", "showTerm", "tvSeasonTerm", "ratingIndex", "descriptionTerm"
};

IF [media] = "software" THEN [attribute] IN { "softwareDeveloper" };

IF [media] = "all" THEN [attribute] IN {
  "actorTerm", "languageTerm", "allArtistTerm", "tvEpisodeTerm", "shortFilmTerm", "directorTerm",
  "releaseYearTerm", "titleTerm", "featureFilmTerm", "ratingIndex", "keywordsTerm",
  "descriptionTerm", "authorTerm", "genreIndex", "mixTerm", "allTrackTerm", "artistTerm",
  "composerTerm", "tvSeasonTerm", "producerTerm", "ratingTerm", "songTerm", "movieArtistTerm",
  "showTerm", "movieTerm", "albumTerm"
};
