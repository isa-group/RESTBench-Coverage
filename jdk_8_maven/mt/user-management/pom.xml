                                <excludedClass>com.giassi.microservice.demo2.rest.users.dtos.requests.LoginRequestDTO</excludedClass>
                                <excludedClass>com.giassi.microservice.demo2.rest.users.dtos.requests.RegisterUserAccountDTO</excludedClass>
