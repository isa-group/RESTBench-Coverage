          "description": "Fully-qualified exception class (may be omitted in prod)."
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message (may include nested cause chain)."
        },
        "path": {
          "type": "string",
          "description": "Request path where the error happened."
        }
