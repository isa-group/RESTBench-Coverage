        // Fault200. Received A Response From API That Is Not Valid According To Its Schema. GET:/banks/institutions -> [Path '/errors/1'] Object instance has properties which are not allowed by the schema: ["code"]
        Response resp6 = given().accept("application/json")
                .get(baseUrlOfSut + "/banks/institutions?" + 
                    "search=04i1JPGRbg8Tzm&" + 
                    "fields=ZIP%2COFFDOM%2CCITY%2CCOUNTY%2CSTNAME%2CSTALP%2CNAME%2CACTIVE%2CCERT%2CCBSA%2CASSET%2CNETINC%2CDEP%2CDEPDOM%2CROE%2CROA%2CDATEUPDT%2COFFICES&" + 
