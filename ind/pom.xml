<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>es.us.isa.httpmutator.experiment.services</groupId>
        <artifactId>httpmutator-benchmark</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ind</artifactId>
    <packaging>pom</packaging>

    <name>ind</name>
    <url>http://maven.apache.org</url>
    <modules>
        <module>amadeus</module>
        <module>deutschebahn</module>
        <module>dhl</module>
        <module>fdic</module>
        <module>foursquare</module>
        <module>github</module>
        <module>gitlab</module>
        <module>itunes</module>
        <module>marvel</module>
        <module>nytimesbooks</module>
        <module>ohsome</module>
        <module>omdb</module>
        <module>restcountries</module>
        <module>spotify</module>
        <module>stripe</module>
        <module>vimeo</module>
        <module>yelp</module>
        <module>youtube-ind</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>select-toolchain</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>1.8</version>
                            <vendor>any</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
